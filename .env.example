VITAK_ENV=development
VITAK_HOST=127.0.0.1
VITAK_PORT=8000
VITAK_DATA_DIR=./data
VITAK_INTERNAL_TOKEN=change-me-in-local-development
VITAK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional. Ingestion extraction uses this OpenAI-compatible endpoint.
# Runtime answer generation never calls a generative model.
VITAK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITAK_LLM_API_KEY=
VITAK_LLM_MODEL=qwen-plus
VITAK_EMBEDDING_MODEL=text-embedding-v4
