VITAK_ENV=development
VITAK_HOST=127.0.0.1
VITAK_PORT=8000
VITAK_DATA_DIR=./data
VITAK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITAK_RESEARCH_SNAPSHOT_VERSION=vitak-research-2026.11-t02
VITAK_SESSION_TTL_HOURS=24
# Optional override; defaults to data/runtime/research_auth.sqlite3.
# VITAK_AUTH_DB_PATH=./data/runtime/research_auth.sqlite3

# Optional. Ingestion extraction uses this OpenAI-compatible endpoint.
VITAK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITAK_LLM_API_KEY=
VITAK_LLM_MODEL=qwen-plus
VITAK_EMBEDDING_MODEL=text-embedding-v4

# Optional evidence-constrained runtime answer generation.
# Disabled by default. The API key must stay on the backend and never enters
# the GitHub Pages build.
VITAK_RUNTIME_LLM_ENABLED=false
VITAK_RUNTIME_LLM_BASE_URL=https://api.deepseek.com/v1
VITAK_RUNTIME_LLM_API_KEY=
VITAK_RUNTIME_LLM_MODEL=deepseek-chat
VITAK_RUNTIME_LLM_TIMEOUT_SECONDS=30
VITAK_RUNTIME_LLM_TEMPERATURE=0.2
VITAK_RUNTIME_LLM_MAX_CONTEXT_CHARS=18000
VITAK_RUNTIME_LLM_JSON_MODE=true

# Evidence-export policy. cloud_public never permits internal/private evidence.
# Only a verified local/LAN endpoint may opt in to protected evidence.
VITAK_RUNTIME_LLM_ENDPOINT_CLASS=cloud_public
VITAK_RUNTIME_LLM_ALLOW_PROTECTED_EVIDENCE=false
